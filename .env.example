# Conexão com o banco PostgreSQL
DATABASE_URL=postgresql://usuario:senha@host:5432/chc_fiscal
DATABASE_SSL=true

# Chave de autenticação da API CHC-Fiscal (Bearer token único do escritório)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHC_API_KEY=coloque_aqui_uma_chave_segura_gerada_aleatoriamente

# Porta da aplicação (PaaS geralmente define automaticamente)
PORT=3000

# Ambiente
NODE_ENV=production
